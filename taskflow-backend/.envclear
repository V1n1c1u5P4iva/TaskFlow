# ==========================================
# TASKFLOW AI - Configuração do Backend
# ==========================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ------------------------------------------
# JWT - Chave Secreta (MUDE EM PRODUÇÃO!)
# Gere uma chave segura com: openssl rand -hex 32
# ------------------------------------------
SECRET_KEY=mude-esta-chave-em-producao-use-openssl-rand-hex-32

# ------------------------------------------
# PostgreSQL
# ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DATABASE=taskflow_db

# ------------------------------------------
# CORS - URL do frontend
# ------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# JWT - Expiração do token (minutos)
# ------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------
# Google Gemini AI (opcional, mas necessário
# para as funcionalidades de IA)
# Obtenha em: https://aistudio.google.com/app/apikey
# ------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui
